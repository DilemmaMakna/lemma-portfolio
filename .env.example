# Copy to .env.local for local development. .env.local is git-ignored; never commit real values.
# Production values are set in Vercel (Project → Settings → Environment Variables).

# Public origin for canonical URLs, sitemap, JSON-LD and /llms.txt.
# Optional. Defaults to https://dilemma-makna.com. Must be an absolute URL; a trailing slash is removed.
NEXT_PUBLIC_SITE_URL=https://dilemma-makna.com

# Token from Google Search Console ("HTML tag" method). Rendered as <meta name="google-site-verification">.
# Optional. Leave empty to skip.
GOOGLE_SITE_VERIFICATION=

# Webhook that receives contact form submissions (e.g. Make, Zapier, n8n or Formspree).
# Optional. Server-only: never exposed to the browser.
CONTACT_WEBHOOK_URL=
