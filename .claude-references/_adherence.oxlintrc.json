{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/buttons/**",
              "components/cards/**",
              "components/feedback/**",
              "components/navigation/**",
              "components/sections/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "JSXOpeningElement[name.name='BarrelBackdrop'] > JSXAttribute > JSXIdentifier[name!=/^(?:opacity|style|key|ref|className|style|children)$/]",
        "message": "<BarrelBackdrop> doesn't accept that prop. Declared props: opacity, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|href|trailingIcon|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, href, trailingIcon, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|accent|ghost|deep)$/]",
        "message": "<Button> variant must be one of 'primary' | 'accent' | 'ghost' | 'deep'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg|xl)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg' | 'xl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|as|children|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: tone, as, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:muted|warm|light|dark|accent)$/]",
        "message": "<Eyebrow> tone must be one of 'muted' | 'warm' | 'light' | 'dark' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='HaloCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:width|height|rotate|variant|children|style|key|ref|className|style|children)$/]",
        "message": "<HaloCard> doesn't accept that prop. Declared props: width, height, rotate, variant, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='HaloCard'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:orange|magenta|olive)$/]",
        "message": "<HaloCard> variant must be one of 'orange' | 'magenta' | 'olive'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|href|ariaLabel|children|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: variant, size, href, ariaLabel, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|accent|ghost|deep)$/]",
        "message": "<IconButton> variant must be one of 'primary' | 'accent' | 'ghost' | 'deep'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg|xl)$/]",
        "message": "<IconButton> size must be one of 'sm' | 'md' | 'lg' | 'xl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IndexBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|active|tone|onClick|style|key|ref|className|style|children)$/]",
        "message": "<IndexBadge> doesn't accept that prop. Declared props: value, active, tone, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IndexBadge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:dark|light)$/]",
        "message": "<IndexBadge> tone must be one of 'dark' | 'light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavbarLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|href|label|key|ref|className|style|children)$/]",
        "message": "<NavbarLink> doesn't accept that prop. Declared props: id, href, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProjectCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|description|imageSrc|imageAlt|href|imageHeight|onClick|style|key|ref|className|style|children)$/]",
        "message": "<ProjectCard> doesn't accept that prop. Declared props: eyebrow, title, description, imageSrc, imageAlt, href, imageHeight, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ServiceTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:index|count|active|variant|title|description|scheme|decoration|onSelect|style|key|ref|className|style|children)$/]",
        "message": "<ServiceTile> doesn't accept that prop. Declared props: index, count, active, variant, title, description, scheme, decoration, onSelect, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ServiceTile'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:magenta|teal|olive|orange)$/]",
        "message": "<ServiceTile> variant must be one of 'magenta' | 'teal' | 'olive' | 'orange'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatPill'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|value|dividerBefore|style|key|ref|className|style|children)$/]",
        "message": "<StatPill> doesn't accept that prop. Declared props: icon, value, dividerBefore, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
